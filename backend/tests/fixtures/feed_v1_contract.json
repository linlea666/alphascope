{
  "_comment": "Keys every feed.v1 response carries. Shared with newsroom/backend/tests (the client side). Additions are allowed; removing or renaming a key is a v2 change.",
  "meta": ["schema", "server_time", "settle_seconds", "limits", "rules"],
  "meta.rules": ["liq_tolerance", "stale_factor", "poll_minutes", "health"],
  "events": ["schema", "as_of", "settled_before", "after_id", "next_after_id", "head_id", "has_more", "rows"],
  "events.row": ["source_id", "trader_key", "venue", "display_name", "handle", "coin", "kind", "side", "szi_before",
                 "szi_after", "notional_change", "mark_px", "entry_px", "leverage", "liq_px", "event_time",
                 "time_precision", "window_start", "observed_at"],
  "context": ["schema", "as_of", "trader", "watch", "positions", "recent_events", "metrics", "quality", "fill_coverage",
              "cycles", "confirmed_liquidations", "okx"],
  "context.trader": ["trader_key", "venue", "display_name", "handle", "first_seen_at", "account_value", "tier",
                     "quality_flags", "enrichment_flags", "month_pnl", "alltime_pnl", "leaderboard_fetched_at"],
  "context.watch": ["tier", "last_observed_at", "stale_after", "is_fresh", "failures", "account_value", "n_positions",
                    "gross_notional"],
  "context.position": ["coin", "szi", "notional_usd", "mark_px", "entry_px", "leverage", "margin_mode", "liq_px", "upl",
                       "opened_at", "opened_at_source", "opened_after", "first_seen_at", "observed_at", "implied_margin"],
  "context.recent_event": ["source_id", "coin", "kind", "side", "szi_before", "szi_after", "notional_change", "mark_px",
                           "event_time", "time_precision", "window_start", "observed_at"],
  "context.metric": ["window", "computed_at", "covered", "n_points", "twr", "mdd", "pnl", "reliability", "notes"],
  "context.quality": ["styles", "timing", "copy", "health"],
  "context.fill_coverage": ["source", "status", "earliest_at", "latest_at", "n_records", "truncated", "last_synced_at"],
  "context.cycle": ["coin", "direction", "opened_at", "version", "closed_at", "status", "complete", "max_notional",
                    "realized_pnl", "fees"],
  "context.confirmed_liquidation": ["time", "coin", "px", "sz", "dir", "closed_pnl", "liquidation"],
  "context.okx": ["closes", "totals", "trader"],
  "context.okx.close": ["pos_id", "coin", "direction", "open_time", "close_time", "max_notional", "pnl", "realized_pnl",
                        "close_type", "liquidated", "lever"],
  "at_risk": ["schema", "as_of", "max_dist", "rows"],
  "at_risk.row": ["trader_key", "venue", "coin", "szi", "notional_usd", "mark_px", "entry_px", "leverage", "liq_px",
                  "upl", "opened_at_source", "first_seen_at", "observed_at", "account_value", "liq_dist"],
  "health": ["schema", "as_of", "rules", "sources"],
  "health.sources": ["radar_hyperliquid", "radar_okx", "market_event", "jobs", "fill_archive", "okx_history",
                     "copy_score"],
  "health.radar": ["watched", "fresh", "positioned", "latest", "oldest", "fresh_ratio", "status"]
}
