<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="675" viewBox="0 0 1200 675" font-family="{{ font }}">
  <rect width="1200" height="675" fill="{{ c.bg }}"/>
  <rect x="0" y="0" width="12" height="675" fill="{{ c.accent }}"/>
  <text x="64" y="92" font-size="30" fill="{{ c.muted }}">{{ t.kicker }}</text>
  <text x="64" y="160" font-size="54" font-weight="700" fill="{{ c.text }}">{{ t.title }}</text>
  <text x="64" y="212" font-size="28" fill="{{ c.muted }}">{{ t.subject }}</text>
  {% for row in rows %}
  <text x="{{ 64 + (loop.index0 % 3) * 370 }}" y="{{ 300 + (loop.index0 // 3) * 130 }}" font-size="24" fill="{{ c.muted }}">{{ row.label }}</text>
  <text x="{{ 64 + (loop.index0 % 3) * 370 }}" y="{{ 350 + (loop.index0 // 3) * 130 }}" font-size="42" font-weight="700" fill="{{ c.text }}">{{ row.value }}</text>
  {% endfor %}
  {% for note in notes %}
  <text x="64" y="{{ 580 + loop.index0 * 26 }}" font-size="19" fill="{{ c.warn }}">{{ note }}</text>
  {% endfor %}
  <text x="64" y="650" font-size="17" fill="{{ c.muted }}">{{ t.footer }}</text>
  <text x="1136" y="650" font-size="17" fill="{{ c.muted }}" text-anchor="end">{{ t.brand }}</text>
</svg>
