{#- Square cards (nr/cards/square.py): portrait, built around the trader. Text is escaped by Jinja; figures are facts. -#}
{%- macro avatar(id, who, cx, cy, r) -%}
  <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ r + 6 }}" fill="{{ c.accent }}" fill-opacity="0.35"/>
  {%- if who.avatar %}
  <clipPath id="{{ id }}"><circle cx="{{ cx }}" cy="{{ cy }}" r="{{ r }}"/></clipPath>
  <image x="{{ cx - r }}" y="{{ cy - r }}" width="{{ 2 * r }}" height="{{ 2 * r }}" href="{{ who.avatar }}" clip-path="url(#{{ id }})" preserveAspectRatio="xMidYMid slice"/>
  {%- else %}
  <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ r }}" fill="{{ c.chip }}"/>
  <text x="{{ cx }}" y="{{ cy + r * 0.36 }}" font-size="{{ r }}" font-weight="700" fill="{{ c.accent }}" text-anchor="middle">{{ who.initial }}</text>
  {%- endif %}
{%- endmacro -%}
{%- macro tile(x, y, w, h, t) -%}
  <rect x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}" rx="18" fill="{{ c.panel }}" stroke="{{ c.line }}"/>
  <text x="{{ x + 28 }}" y="{{ y + 48 }}" font-size="26" fill="{{ c.muted }}">{{ t.label }}</text>
  <text x="{{ x + 28 }}" y="{{ y + h - 34 }}" font-size="{{ t.size or 44 }}" font-weight="700" fill="{{ c[t.tone] }}">{{ t.value or "—" }}</text>
{%- endmacro -%}
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}" font-family="{{ font }}">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="{{ c.bg2 }}"/><stop offset="1" stop-color="{{ c.bg }}"/></linearGradient>
    <radialGradient id="glow" cx="0.5" cy="0.28" r="0.6"><stop offset="0" stop-color="{{ c.accent }}" stop-opacity="0.16"/><stop offset="1" stop-color="{{ c.accent }}" stop-opacity="0"/></radialGradient>
  </defs>
  <rect width="{{ w }}" height="{{ h }}" fill="url(#bg)"/>
  <rect width="{{ w }}" height="{{ h }}" fill="url(#glow)"/>
  <rect x="60" y="44" width="{{ 40 + (brand|length + venue|length) * 22 }}" height="52" rx="26" fill="{{ c.chip }}"/>
  <text x="84" y="80" font-size="26" font-weight="700" fill="{{ c.accent }}">{{ brand }} · {{ venue }}</text>
  <text x="1020" y="80" font-size="24" fill="{{ c.muted }}" text-anchor="end">{{ date }}</text>
  <text x="60" y="176" font-size="{{ 58 if title|length < 15 else 46 }}" font-weight="800" fill="{{ c.text }}">{{ title }}</text>
  {% if subtitle %}<text x="60" y="226" font-size="26" fill="{{ c.muted }}">{{ subtitle }}</text>{% endif %}

  {% if kind == "podium" %}
    {% set p = people[0] %}
    {{ avatar("a0", p, 540, 410, 130) }}
    <text x="540" y="612" font-size="{{ p.name_size }}" font-weight="700" fill="{{ c.text }}" text-anchor="middle">{{ p.name }}</text>
    <text x="540" y="760" font-size="150" font-weight="800" fill="{{ c.accent }}" text-anchor="middle">{{ p.big }}</text>
    <text x="540" y="828" font-size="32" fill="{{ c.muted }}" text-anchor="middle">第 {{ p.rank }} 名 <tspan fill="{{ c[p.move_tone] }}" font-weight="700">{{ p.move }}</tspan></text>
    <text x="540" y="880" font-size="30" fill="{{ c.text }}" text-anchor="middle">榜单收益 {{ p.pnl or "—" }} · 带单资产 {{ p.assets or "—" }}{% if p.small %} <tspan fill="{{ c.accent }}" font-weight="700">小资金</tspan>{% endif %}</text>
    {% for q in people[1:3] %}
      {% set x = 60 + loop.index0 * 500 %}
      <rect x="{{ x }}" y="940" width="460" height="300" rx="22" fill="{{ c.panel }}" stroke="{{ c.line }}"/>
      {{ avatar("a" ~ loop.index, q, x + 90, 1030, 58) }}
      <text x="{{ x + 170 }}" y="1018" font-size="{{ q.name_size }}" font-weight="700" fill="{{ c.text }}">{{ q.name }}</text>
      <text x="{{ x + 170 }}" y="1062" font-size="26" fill="{{ c.muted }}">第 {{ q.rank }} 名 <tspan fill="{{ c[q.move_tone] }}">{{ q.move }}</tspan></text>
      <text x="{{ x + 32 }}" y="1170" font-size="84" font-weight="800" fill="{{ c.accent }}">{{ q.big }}</text>
      <text x="{{ x + 32 }}" y="1216" font-size="24" fill="{{ c.muted }}">带单资产 {{ q.assets or "—" }}{% if q.small %} · 小资金{% endif %}</text>
    {% endfor %}

  {% elif kind == "persona" %}
    {{ avatar("a0", who, 540, 440, 150) }}
    <text x="540" y="664" font-size="{{ name_size }}" font-weight="700" fill="{{ c.text }}" text-anchor="middle">{{ who.name }}</text>
    {% if badge %}
      <rect x="{{ 540 - (badge|length * 17 + 40) }}" y="694" width="{{ badge|length * 34 + 80 }}" height="64" rx="32" fill="{{ c[badge_tone] }}" fill-opacity="0.18" stroke="{{ c[badge_tone] }}"/>
      <text x="540" y="738" font-size="34" font-weight="800" fill="{{ c[badge_tone] }}" text-anchor="middle">{{ badge }}</text>
    {% endif %}
    {% set ns = namespace(x=540 - (tags|join('')|length * 13 + tags|length * 24)) %}
    {% for tg in tags %}
      <rect x="{{ ns.x }}" y="782" width="{{ tg|length * 26 + 36 }}" height="48" rx="24" fill="{{ c.chip }}"/>
      <text x="{{ ns.x + 18 }}" y="815" font-size="26" fill="{{ c.text }}">{{ tg }}</text>
      {% set ns.x = ns.x + tg|length * 26 + 48 %}
    {% endfor %}
    {% for t in tiles %}
      {{ tile(60 + (loop.index0 % 3) * 330, 870 + (loop.index0 // 3) * 190, 300, 170, t) }}
    {% endfor %}

  {% elif kind == "star" %}
    {{ avatar("a0", who, 190, 380, 120) }}
    <text x="350" y="362" font-size="{{ name_size }}" font-weight="800" fill="{{ c.text }}">{{ who.name }}</text>
    <text x="350" y="424" font-size="40" font-weight="700" fill="{{ c.accent }}">{{ action }}</text>
    <rect x="60" y="540" width="960" height="270" rx="26" fill="{{ c.panel }}" stroke="{{ c.line }}"/>
    <text x="100" y="604" font-size="30" fill="{{ c.muted }}">{{ big_label }}</text>
    <text x="100" y="750" font-size="{{ big_size }}" font-weight="800" fill="{{ c[big_tone] }}">{{ big or "—" }}</text>
    {% if big_label != "仓位" and size %}<text x="980" y="604" font-size="28" fill="{{ c.muted }}" text-anchor="end">仓位 {{ size }}</text>{% endif %}
    {% for t in tiles %}
      {{ tile(60 + (loop.index0 % 3) * 330, 850 + (loop.index0 // 3) * 190, 300, 170, t) }}
    {% endfor %}

  {% elif kind == "duel" %}
    {% for sd in sides %}
      {% set x = 60 + loop.index0 * 500 %}
      <rect x="{{ x }}" y="280" width="460" height="930" rx="26" fill="{{ c.panel }}" stroke="{{ c.accent if sd.lead else c.line }}" stroke-width="{{ 4 if sd.lead else 1 }}"/>
      {% if sd.lead %}<rect x="{{ x + 150 }}" y="258" width="160" height="48" rx="24" fill="{{ c.accent }}"/><text x="{{ x + 230 }}" y="291" font-size="28" font-weight="800" fill="{{ c.bg }}" text-anchor="middle">领先</text>{% endif %}
      {{ avatar("a" ~ loop.index, sd, x + 230, 440, 110) }}
      <text x="{{ x + 230 }}" y="610" font-size="{{ sd.name_size }}" font-weight="700" fill="{{ c.text }}" text-anchor="middle">{{ sd.name }}</text>
      <rect x="{{ x + 150 }}" y="640" width="160" height="60" rx="30" fill="{{ c[sd.side_tone] }}" fill-opacity="0.2" stroke="{{ c[sd.side_tone] }}"/>
      <text x="{{ x + 230 }}" y="682" font-size="32" font-weight="800" fill="{{ c[sd.side_tone] }}" text-anchor="middle">{{ sd.side }}</text>
      <text x="{{ x + 230 }}" y="790" font-size="52" font-weight="800" fill="{{ c.text }}" text-anchor="middle">{{ sd.notional or "—" }}</text>
      <text x="{{ x + 230 }}" y="840" font-size="28" fill="{{ c.muted }}" text-anchor="middle">{{ sd.leverage or "" }}</text>
      <text x="{{ x + 230 }}" y="960" font-size="28" fill="{{ c.muted }}" text-anchor="middle">{{ sd.result_label }}</text>
      <text x="{{ x + 230 }}" y="1040" font-size="{{ sd.result_size }}" font-weight="800" fill="{{ c[sd.result_tone] }}" text-anchor="middle">{{ sd.result or "—" }}</text>
    {% endfor %}
    <circle cx="540" cy="440" r="52" fill="{{ c.accent }}"/>
    <text x="540" y="456" font-size="44" font-weight="900" fill="{{ c.bg }}" text-anchor="middle">VS</text>
  {% endif %}

  <text x="60" y="1306" font-size="24" fill="{{ c.muted }}">{{ footer }}</text>
</svg>
