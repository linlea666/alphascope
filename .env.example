# Copy to .env and adjust. Never commit real secrets.
ALPHASCOPE_DATABASE_URL=postgresql+psycopg://localhost/alphascope
ALPHASCOPE_RAW_STORE_DIR=../data/raw
# Share of the 1200 weight/min IP budget this deployment may use (0-1).
ALPHASCOPE_HL_WEIGHT_SAFETY=0.5
ALPHASCOPE_LEADERBOARD_INTERVAL_MINUTES=60
ALPHASCOPE_LEADERBOARD_SNAPSHOT_HOURS=6
ALPHASCOPE_ENRICH_BATCH_SIZE=200
ALPHASCOPE_ENRICH_INTERVAL_MINUTES=10
ALPHASCOPE_PORTFOLIO_REFRESH_DAYS=7
# Frontend (server-side fetch target)
API_BASE_URL=http://localhost:8000

# --- docker compose (server) ---
POSTGRES_DB=alphascope
POSTGRES_USER=alphascope
POSTGRES_PASSWORD=change-me
